# Phase 2 admin backend — copy to `.env` for local dev and set these in the
# Vercel project settings (Settings → Environment Variables) for production.
# NEVER commit the real `.env`. These are read only by serverless functions
# in /api and are never bundled into the client.

# GitHub fine-grained Personal Access Token, scoped to ONLY this repo, with
# "Contents: Read and write" permission (nothing else). Used to commit updated
# JSON back to the repo.
GITHUB_TOKEN=

# "owner/repo", e.g. earl105/website26
GITHUB_REPO=earl105/website26

# Branch to commit to (defaults to "main" if unset)
GITHUB_BRANCH=main

# Admin password verifier produced by `npm run hash-password`.
# Format: scrypt$N$r$p$<saltHex>$<hashHex>  (NOT your plaintext password)
ADMIN_PASSWORD_HASH=

# Random secret (>= 32 chars) used to sign the admin session JWT.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
